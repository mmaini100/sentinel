# ============================================================
# Sentinel — Environment Configuration
# Copy this file to .env and fill in the values.
# ============================================================

# --- Database ---
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@postgres:5432/sentinel

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- JWT Auth ---
JWT_SECRET_KEY=change-me-to-a-random-secret-at-least-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- LLM Providers ---
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
LLM_PRIMARY_PROVIDER=groq
LLM_TIMEOUT_SECONDS=10

# --- Anomaly Detection ---
ANOMALY_DETECTOR=zscore
# Options: zscore, isolation_forest

# --- Correlation ---
CORRELATION_WINDOW_SECONDS=60

# --- General ---
ENVIRONMENT=development
